{
	"name": "user-engine",
	"version": "1.0.0",
	"description": "A microservice with nest framework, typeorm, apache kafka and kubernetes.",
	"license": "MIT",
	"author": "Newerton Vargas de Araujo",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "biome check --write --unsafe",
		"test": "jest --config ./test/unit/jest.config.ts",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage --silent --config ./test/unit/jest.config.ts",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/e2e/jest.config.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"@nestjs/axios": "4.0.1",
		"@nestjs/common": "11.2.3",
		"@nestjs/config": "4.0.4",
		"@nestjs/mapped-types": "2.1.1",
		"@nestjs/microservices": "11.2.3",
		"@nestjs/platform-express": "11.2.3",
		"env-var": "7.5.0",
		"jsonwebtoken": "9.0.3",
		"kafkajs": "2.2.4",
		"keycloak-connect": "26.1.1",
		"lightship": "9.0.4",
		"nest-keycloak-connect": "1.10.1",
		"rxjs": "7.8.2",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@nestjs/cli": "11.0.24",
		"@nestjs/schematics": "11.1.0",
		"@nestjs/testing": "11.2.3",
		"@swc/cli": "0.8.1",
		"@swc/core": "1.16.1",
		"@swc/jest": "0.2.39",
		"@types/express": "5.0.6",
		"@types/jest": "30.0.0",
		"@types/jsonwebtoken": "9.0.10",
		"@types/node": "26.4.1",
		"@types/supertest": "7.2.1",
		"husky": "9.1.7",
		"jest": "30.5.1",
		"prettier": "3.9.6",
		"supertest": "7.2.2",
		"ts-jest": "29.4.12",
		"ts-loader": "9.6.2",
		"ts-node": "10.9.2",
		"tsconfig-paths": "4.2.0",
		"typescript": "6.0.3"
	},
	"overrides": {
		"nest-keycloak-connect": {
			"@nestjs/common": "11.2.3",
			"@nestjs/core": "11.1.27",
			"rxjs": "^7.8.2"
		},
		"@babel/core": "^7.29.1",
		"brace-expansion": "^5.0.9",
		"diff": "^4.0.4",
		"elliptic": "npm:@mapped/elliptic@^6.6.4",
		"js-yaml": "^5.2.3",
		"multer": "^2.1.2",
		"piscina": "^4.9.3",
		"extract-zip": "^2.0.1"
	},
	"allowScripts": {
		"chromedriver@140.0.0": true,
		"@swc/core@1.15.43": true,
		"unrs-resolver@1.12.2": true
	}
}
